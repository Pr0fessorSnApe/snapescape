# =============================================================================
# SNAPESCAPE — Professional .gitignore
# Created By: Pr0Fessor_SnApe
# Safe for public GitHub upload
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS & CREDENTIALS (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
config/vault.json
config/*.local.json
**/secrets/
**/*secret*
**/*credentials*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
*.crt
*.csr
serviceAccountKey.json
firebase-adminsdk*.json

# -----------------------------------------------------------------------------
# PYTHON
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.eggs/
*.egg
*.egg-info/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
*.cover
.hypothesis/
celerybeat-schedule
celerybeat.pid

# -----------------------------------------------------------------------------
# NODE / FRONTEND
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
package-lock.json.bak
dashboard/dist/
dashboard/.vite/
services/browser-engine/node_modules/
services/puppeteer-engine/node_modules/
desktop/node_modules/
*.tsbuildinfo

# Playwright / Puppeteer browser downloads
**/.cache/ms-playwright/
**/playwright/.cache/

# -----------------------------------------------------------------------------
# RUST
# -----------------------------------------------------------------------------
engines/rust/target/
**/target/
Cargo.lock.bak

# -----------------------------------------------------------------------------
# GO
# -----------------------------------------------------------------------------
services/go-worker/bin/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# -----------------------------------------------------------------------------
# C / C++ / NIM / ZIG (build artifacts)
# -----------------------------------------------------------------------------
engines/c/**/build/
engines/cpp/**/build/
engines/nim/**/nimcache/
engines/zig/**/zig-out/
engines/zig/**/.zig-cache/
*.o
*.obj
*.a
*.lib

# -----------------------------------------------------------------------------
# RUNTIME DATA (generated during scans)
# -----------------------------------------------------------------------------
data/evidence/*
!data/evidence/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/pids/
data/audit.log
data/*.log
logs/
*.log

# -----------------------------------------------------------------------------
# DOCKER & KUBERNETES (local overrides)
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
*.local.yaml
.kube/

# -----------------------------------------------------------------------------
# DESKTOP / ELECTRON
# -----------------------------------------------------------------------------
desktop/dist/
desktop/out/
desktop/release/

# -----------------------------------------------------------------------------
# IDE & EDITORS
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# OS FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Branding assets ARE committed (logo + banner)
# branding/logo.png
# branding/banner.png
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/
*.pid
*.seed
*.pid.lock
.terraform/
*.tfstate
*.tfstate.*

# -----------------------------------------------------------------------------
# WEASYPRINT / PDF TEMP
# -----------------------------------------------------------------------------
.weasyprint-cache/

# -----------------------------------------------------------------------------
# OPTIONAL: uncomment if you don't want to ship lockfiles
# -----------------------------------------------------------------------------
# package-lock.json
# Cargo.lock
